# Base URL of the Flask JSON API. Copy to .env (gitignored).
# Local dev (Android emulator uses 10.0.2.2 to reach host localhost):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# iOS simulator / web:
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:5000
# Production VPS:
#   EXPO_PUBLIC_API_URL=https://api.daddiespadel.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000
