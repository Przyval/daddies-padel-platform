# Copy to .env for local dev (python-dotenv loads it). NEVER commit the real .env.
# In production (Railway) set these in the dashboard, not in a file.

# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Railway provides DATABASE_URL automatically when you add a Postgres plugin.
# Local dev falls back to sqlite:///daddies.db if unset.
DATABASE_URL=

# 'production' enables strict secret checks + secure cookies. Use 'development' locally.
FLASK_ENV=development

# Dev-only: set to 1 to enable the debugger. Ignored in production.
FLASK_DEBUG=0
