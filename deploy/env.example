# EnvironmentFile for systemd — copy to /etc/daddies/env on the VPS.
# Format: KEY=value (no quotes, no `export`). chmod 600, owned by root.
#
#   sudo mkdir -p /etc/daddies
#   sudo cp deploy/env.example /etc/daddies/env
#   sudo nano /etc/daddies/env        # fill in real values
#   sudo chmod 600 /etc/daddies/env

# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_HEX
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_64_HEX

# Local Postgres (created in DEPLOY.md step 3).
DATABASE_URL=postgresql://daddies:CHANGE_ME_DB_PASSWORD@localhost:5432/daddies

# Enables strict prod checks + secure cookies.
FLASK_ENV=production

# Needed by `flask db upgrade` during deploy.
FLASK_APP=run.py
